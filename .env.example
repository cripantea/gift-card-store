# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL="mysql://root:password@localhost:3306/gift_card_store"

# --- Stripe ---
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_stripe_webhook_signing_secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_stripe_publishable_key"

# --- PayPal ---
PAYPAL_CLIENT_ID="replace_with_your_paypal_client_id"
PAYPAL_CLIENT_SECRET="replace_with_your_paypal_client_secret"
PAYPAL_MODE="sandbox"
PAYPAL_WEBHOOK_ID="replace_with_your_paypal_webhook_id"
# Stesso valore di PAYPAL_CLIENT_ID: esposto al browser per caricare l'SDK PayPal JS (client id, non il secret).
NEXT_PUBLIC_PAYPAL_CLIENT_ID="replace_with_your_paypal_client_id"

# --- SMTP (email transazionali, stesso relay Brevo usato dai progetti Laravel) ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USERNAME="replace_with_your_brevo_smtp_username"
SMTP_PASSWORD="replace_with_your_brevo_smtp_password"
EMAIL_FROM="MÀD Vigevano <noreply@dominio.it>"

# --- App ---
NEXT_PUBLIC_BASE_URL="https://shop.madvigevano.it"

# --- FusionCRM ---
# Webhook unificato: un contatto CRM per ogni acquisto pagato (Give Away escluso).
# Contiene il token segreto dell'endpoint: tienilo solo nel .env del server.
FUSION_CRM_WEBHOOK_URL=""

# --- Portale Cassa ---
# PIN a 4 cifre richiesto al personale del salone per accedere a /cassa.
# Obbligatorio: senza PIN la cassa resta chiusa. Evita sequenze o cifre ripetute.
CASSA_PIN=""
# Chiave casuale lunga per firmare la sessione della cassa (es. `openssl rand -hex 32`).
CASSA_SESSION_SECRET=""
