// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  FIXED_AMOUNT
}

enum DiscountScope {
  ALL
  SELECTED
}

enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

model Customer {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?  @unique
  phone     String   @unique
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id               String        @id @default(uuid())
  customerId       String
  customer         Customer      @relation(fields: [customerId], references: [id])
  orderNumber      String        @unique
  // Importo realmente pagato (valore della card meno l'eventuale sconto).
  totalAmount      Decimal       @db.Decimal(10, 2)
  // Prodotto del catalogo (src/lib/giftCardProducts.ts) e valore nominale della card.
  productSlug      String?
  faceValue        Decimal?      @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  discountCodeId   String?
  discountCode     DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  // Copia del codice usato: resta anche se il codice viene eliminato dall'admin.
  discountCodeText String?
  // Condizioni di vendita accettate al checkout (src/content/legal).
  termsVersion     String?
  termsAcceptedAt  DateTime?
  status           OrderStatus   @default(PENDING)
  payment          Payment?
  giftCard         GiftCard?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([customerId])
  @@index([discountCodeId])
}

model Payment {
  id                   String          @id @default(uuid())
  orderId              String          @unique
  order                Order           @relation(fields: [orderId], references: [id])
  provider             PaymentProvider
  transactionId        String
  amount               Decimal         @db.Decimal(10, 2)
  status               PaymentStatus
  paymentMethodDetails Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([transactionId])
}

model GiftCard {
  id                 String          @id @default(uuid())
  orderId            String          @unique
  order              Order           @relation(fields: [orderId], references: [id])
  cardCode           String          @unique
  secretToken        String          @unique
  recipientFirstName String
  recipientLastName  String
  recipientPhone     String
  customMessage      String?         @db.Text
  amount             Decimal         @db.Decimal(10, 2)
  isOpened           Boolean         @default(false)
  status             GiftCardStatus  @default(ACTIVE)
  redeemedAt         DateTime?
  expiresAt          DateTime
  scheduledAt        DateTime?
  emailSentAt        DateTime?
  redemptionLogs     RedemptionLog[]
  giveawayEntry      GiveawayEntry?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([scheduledAt, emailSentAt])
}

model RedemptionLog {
  id            String   @id @default(uuid())
  giftCardId    String
  giftCard      GiftCard @relation(fields: [giftCardId], references: [id])
  operatorNotes String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([giftCardId])
}

// Stripe Checkout Sessions can carry the buyer/recipient details as metadata
// and hand them back on `checkout.session.completed`. PayPal Orders have no
// equivalent free-form metadata field, so we stage the same details here,
// keyed by the PayPal order id, until the `PAYMENT.CAPTURE.COMPLETED`
// webhook arrives and consumes (deletes) the row.
model PendingPaypalCheckout {
  id                 String    @id
  buyerFirstName     String
  buyerLastName      String
  buyerPhone         String
  recipientFirstName String
  recipientLastName  String
  recipientPhone     String
  customMessage      String?   @db.Text
  // Importo da pagare (già scontato).
  amount             Decimal   @db.Decimal(10, 2)
  productSlug        String?
  faceValue          Decimal?  @db.Decimal(10, 2)
  discountAmount     Decimal   @default(0) @db.Decimal(10, 2)
  discountCodeId     String?
  discountCodeText   String?
  scheduledAt        DateTime?
  termsVersion       String?
  termsAcceptedAt    DateTime?
  createdAt          DateTime  @default(now())
}

// Codici sconto applicabili all'acquisto di gift card, gestiti da /cassa.
// Lo sconto riduce il prezzo pagato, mai il valore della gift card.
model DiscountCode {
  id           String        @id @default(uuid())
  code         String        @unique
  description  String?
  type         DiscountType
  value        Decimal       @db.Decimal(10, 2)
  scope        DiscountScope @default(ALL)
  // Slug dei prodotti a cui si applica quando scope = SELECTED.
  productSlugs Json?
  minAmount    Decimal?      @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int           @default(0)
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean       @default(true)
  // Mostrato nel banner promo del sito vetrina (GET /api/promo).
  isPublic     Boolean       @default(false)
  orders       Order[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([active, startsAt, endsAt])
}

// Risposte al Give Away (/give-away): ogni partecipante riceve una gift card
// reale da 50 €, una sola per numero di telefono.
model GiveawayEntry {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  phone            String    @unique
  // Email: serve a riconoscere chi ha già partecipato (anche da un altro telefono).
  email            String?   @unique
  // Valore della select "Dove ci hai conosciuto?"; sourceOther se "Altro".
  source           String
  sourceOther      String?
  knownSince       String
  birthDate        DateTime? @db.Date
  // Trattamenti preferiti (valori di SERVIZI_GRUPPI in src/lib/giveawayOptions.ts).
  favoriteServices Json?
  note             String?   @db.Text
  marketingConsent Boolean   @default(false)
  // Prova del consenso marketing (art. 7.1 GDPR): quando e con quale testo.
  marketingConsentAt   DateTime?
  marketingConsentText String?   @db.Text
  // Regolamento e informativa accettati (versione di src/content/legal).
  termsVersion     String?
  termsAcceptedAt  DateTime?
  // Dati personali anonimizzati dopo 24 mesi (/api/cron/retention).
  anonymizedAt     DateTime?
  // Parametro ?src= del link condiviso (es. "whatsapp"), per sapere da dove arriva.
  campaign         String?
  ipHash           String?
  giftCardId       String    @unique
  giftCard         GiftCard  @relation(fields: [giftCardId], references: [id])
  createdAt        DateTime  @default(now())

  @@index([ipHash, createdAt])
}

// Aperture della pagina /give-away (link generico uguale per tutti): solo il
// conteggio, senza sapere chi è. visitorId è un identificativo casuale del
// browser, usato soltanto per contare i visitatori unici.
model GiveawayVisit {
  id        String   @id @default(uuid())
  visitorId String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
}
